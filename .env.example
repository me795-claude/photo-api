# ===== Подключение к LLM (OpenAI-совместимый chat/completions) =====
# Внутренний шлюз LLM ВШЭ:
LLM_BASE_URL=https://llm-api.hse.ru
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODELS_PATH=/v1/models
# Ключ шлюза (Authorization: Bearer ...)
LLM_API_KEY=change-me
# Потоковый ответ (text/event-stream). Для шлюза обязателен: без потока он рвёт соединение через ~30 с
LLM_STREAM=true
# Проверять TLS-сертификат (false — для самоподписанных)
LLM_VERIFY_SSL=true

# Если LLM доступна через Open WebUI, а не через шлюз:
# LLM_BASE_URL=http://host.docker.internal:3000
# LLM_CHAT_PATH=/api/chat/completions
# LLM_MODELS_PATH=/api/models

# Если шлюз доступен только через корпоративный прокси:
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1

# ===== Модель и параметры запроса =====
# Модель должна принимать изображения (image_url)
LLM_MODEL=qwen3.8-flash-next
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_SEED=42
LLM_TIMEOUT=180
# Формат ответа: json_schema | json_object | none
# (если модель отклонит json_schema, клиент сам откатится на json_object, затем на none)
LLM_RESPONSE_FORMAT=json_schema
# Сколько раз переспрашивать модель, если ответ не по схеме
LLM_MAX_RETRIES=2
# Дополнительные поля запроса (JSON). Отключаем рассуждения Qwen — быстрее и без лишнего текста в ответе
LLM_EXTRA_PARAMS={"chat_template_kwargs": {"enable_thinking": false}}

# ===== Изображение =====
IMAGE_MAX_SIDE=1024
IMAGE_JPEG_QUALITY=90
MAX_UPLOAD_MB=15

# ===== Проверки кодом (только ужесточают результат LLM) =====
LOCAL_CHECKS=true
# Допустимое отклонение пропорций от 35×45 (0.04 = 4 %)
LOCAL_ASPECT_TOLERANCE=0.04
# Порог резкости (дисперсия лапласиана), ниже — «размыто». Ловит только явный расфокус;
# основную оценку качества даёт LLM. Для обычных фото с камеры можно поднять до 10–20
LOCAL_BLUR_THRESHOLD=2
# Доля «выбитых» белых / чёрных пикселей в зоне лица
LOCAL_OVEREXPOSED_FRAC=0.20
LOCAL_UNDEREXPOSED_FRAC=0.35

# ===== Сервис =====
APP_PORT=8000
LOG_LEVEL=INFO
